    "# Builders – Transfer learning MobileNetV2 / EfficientNetB0\n",
    "\n",
    "def build_mobilenetv2_transfer():\n",
    "    base_model = keras.applications.MobileNetV2(\n",
    "        input_shape=(128, 128, 3),\n",
    "        include_top=False,\n",
    "        weights=\"imagenet\",\n",
    "    )\n",
    "    base_model.trainable = False\n",
    "\n",
    "    inputs = keras.Input(shape=(32, 32, 3))\n",
    "    x = layers.Resizing(128, 128)(inputs)\n",
    "    x = layers.Rescaling(255.0)(x)\n",
    "    x = layers.Lambda(keras.applications.mobilenet_v2.preprocess_input)(x)\n",
    "    x = base_model(x, training=False)\n",
    "    x = layers.GlobalAveragePooling2D()(x)\n",
    "    x = layers.BatchNormalization()(x)\n",
    "    x = layers.Dense(256, activation=\"relu\")(x)\n",
    "    x = layers.Dropout(0.35)(x)\n",
    "    outputs = layers.Dense(100, activation=\"softmax\")(x)\n",
    "\n",
    "    model = keras.Model(inputs, outputs, name=\"mobilenetv2_transfer\")\n",
    "    return model, base_model\n",
    "\n",
    "def build_efficientnetb0_finetune():\n",
    "    base_model = keras.applications.EfficientNetB0(\n",
    "        input_shape=(160, 160, 3),\n",
    "        include_top=False,\n",
    "        weights=\"imagenet\",\n",
    "    )\n",
    "    base_model.trainable = False\n",
    "\n",
    "    inputs = keras.Input(shape=(32, 32, 3))\n",
    "    x = layers.Resizing(160, 160)(inputs)\n",
    "    x = layers.Rescaling(255.0)(x)\n",
    "    x = base_model(x, training=False)\n",
    "    x = layers.GlobalAveragePooling2D()(x)\n",
    "    x = layers.BatchNormalization()(x)\n",
    "    x = layers.Dense(256, activation=\"relu\")(x)\n",
    "    x = layers.Dropout(0.40)(x)\n",
    "    outputs = layers.Dense(100, activation=\"softmax\")(x)\n",
    "\n",
    "    model = keras.Model(inputs, outputs, name=\"efficientnetb0_finetune\")\n",
    "    return model, base_model\n",
    "\n",
    "model_builders.update({\n",
    "    \"mobilenetv2_transfer\": build_mobilenetv2_transfer,\n",
    "    \"efficientnetb0_finetune\": build_efficientnetb0_finetune,\n",
    "})\n",
    "\n",
    "active_model_names = [\n",
    "    \"cnn_simple\",\n",
    "    \"resnet_like\",\n",
    "    \"mobilenetv2_transfer\",\n",
    "    \"efficientnetb0_finetune\",\n",
    "]\n",
    "active_model_builders = model_builders"
   ]
  },
