    "# Imports + configuration\n",
    "import os\n",
    "import json\n",
    "import csv\n",
    "import random\n",
    "from dataclasses import dataclass\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import tensorflow as tf\n",
    "from tensorflow import keras\n",
    "from tensorflow.keras import layers, callbacks\n",
    "\n",
    "# --- Reproductibilité ---\n",
    "SEED = 42\n",
    "random.seed(SEED)\n",
    "np.random.seed(SEED)\n",
    "tf.random.set_seed(SEED)\n",
    "\n",
    "# --- Hyperparamètres globaux ---\n",
    "BATCH_SIZE = 64\n",
    "MID_TRAIN_EPOCH = 5\n",
    "EPOCHS = 5\n",
    "HEAD_EPOCHS = 2\n",
    "EXTRA_EPOCHS_IF_IMPROVING = 0\n",
    "QUICK_RUN = True\n",
    "\n",
    "STEPS_PER_EPOCH = 50\n",
    "VALIDATION_STEPS = 20\n",
    "\n",
    "LR = 1e-3\n",
    "LR_FINETUNE = 1e-4\n",
    "\n",
    "# --- Répertoires ---\n",
    "os.makedirs(\"models/phase4_checkpoints\", exist_ok=True)\n",
    "os.makedirs(\"models/phase4_models\", exist_ok=True)\n",
    "os.makedirs(\"models/phase4_history\", exist_ok=True)\n",
    "\n",
    "print(\"TF version:\", tf.__version__)\n",
    "print(f\"BATCH_SIZE={BATCH_SIZE}, EPOCHS={EPOCHS}, MID_TRAIN_EPOCH={MID_TRAIN_EPOCH}\")\n",
    "print(f\"QUICK_RUN={QUICK_RUN}, STEPS_PER_EPOCH={STEPS_PER_EPOCH}, VALIDATION_STEPS={VALIDATION_STEPS}\")\n",
    "print(f\"LR={LR}, LR_FINETUNE={LR_FINETUNE}\")"
   ]
