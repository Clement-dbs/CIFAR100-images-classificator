   "source": [
    "# Utilitaires de training, callbacks, export et tuning adaptatif\n",
    "\n",
    "@dataclass\n",
    "class TrainConfig:\n",
    "    name: str\n",
    "    augmentation: str\n",
    "    epochs: int\n",
    "    learning_rate: float\n",
    "    head_epochs: int = 0\n",
    "    fine_tune_lr: float | None = None\n",
    "    unfreeze_layers: int = 0\n",
    "\n",
    "def ensure_output_dirs():\n",
    "    os.makedirs(\"models/phase4_checkpoints\", exist_ok=True)\n",
    "    os.makedirs(\"models/phase4_models\", exist_ok=True)\n",
    "    os.makedirs(\"models/phase4_history\", exist_ok=True)\n",
    "\n",
    "def classification_metrics():\n",
    "    return [\n",
    "        \"accuracy\",\n",
    "        keras.metrics.SparseTopKCategoricalAccuracy(k=5, name=\"top5_acc\"),\n",
    "    ]\n",
    "\n",
    "def get_train_dataset(augmentation_name):\n",
    "    return train_ds_aggressive if augmentation_name == \"aggressive\" else train_ds_mild\n",
    "\n",
    "def make_callbacks(model_name, stage=\"main\", patience=8):\n",
    "    ensure_output_dirs()\n",
    "    return [\n",
    "        callbacks.EarlyStopping(\n",
    "            monitor=\"val_loss\",\n",
    "            patience=patience,\n",
    "            restore_best_weights=True,\n",
    "            verbose=1,\n",
    "        ),\n",
    "        callbacks.ReduceLROnPlateau(\n",
    "            monitor=\"val_loss\",\n",
    "            factor=0.5,\n",
    "            patience=max(3, patience // 2),\n",
    "            min_lr=1e-6,\n",
    "            verbose=1,\n",
    "        ),\n",
    "        callbacks.ModelCheckpoint(\n",
    "            filepath=f\"models/phase4_checkpoints/{model_name}_{stage}.keras\",\n",
    "            monitor=\"val_accuracy\",\n",
    "            save_best_only=True,\n",
    "            mode=\"max\",\n",
    "            verbose=1,\n",
    "        ),\n",
    "    ]\n",
    "\n",
    "def save_history(model_name, history_dict):\n",
    "    \"\"\"Sauvegarde l'historique consolidé en JSON et CSV.\"\"\"\n",
    "    ensure_output_dirs()\n",
    "    json_path = f\"models/phase4_history/{model_name}_history.json\"\n",
    "    with open(json_path, \"w\", encoding=\"utf-8\") as f:\n",
    "        json.dump(history_dict, f, indent=2)\n",
    "\n",
    "    csv_path = f\"models/phase4_history/{model_name}_history.csv\"\n",
    "    keys = list(history_dict.keys())\n",
    "    with open(csv_path, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n",
    "        writer = csv.writer(f)\n",
    "        writer.writerow([\"epoch\"] + keys)\n",
    "        for i in range(len(history_dict[keys[0]])):\n",
    "            writer.writerow([i + 1] + [history_dict[k][i] for k in keys])\n",
    "\n",
    "    print(f\"Historique sauvegardé → {json_path}\")\n",
    "\n",
    "def merge_histories(*history_dicts):\n",
    "    merged = {}\n",
    "    for hist in history_dicts:\n",
    "        for key, values in hist.items():\n",
    "            merged.setdefault(key, []).extend(list(values))\n",
    "    return merged\n",
    "\n",
    "def metric_at(hist, key, epoch):\n",
    "    values = hist.get(key, [])\n",
    "    if not values:\n",
    "        return float(\"nan\")\n",
    "    return float(values[min(epoch - 1, len(values) - 1)])\n",
    "\n",
    "def should_extend_training(hist, key=\"val_accuracy\", lookback=5, min_gain=0.01):\n",
    "    values = hist.get(key, [])\n",
    "    if len(values) <= lookback:\n",
    "        return False\n",
    "    previous_best = max(values[:-lookback]) if len(values) > lookback else values[0]\n",
    "    recent_best = max(values[-lookback:])\n",
    "    return (recent_best - previous_best) >= min_gain and values[-1] >= values[-lookback]\n",
    "\n",
    "def maybe_extend_training(model, model_name, train_ds, history_dict, extra_epochs=EXTRA_EPOCHS_IF_IMPROVING):\n",
    "    if extra_epochs <= 0 or not should_extend_training(history_dict):\n",
    "        return history_dict\n",
    "\n",
    "    current_epochs = len(history_dict[\"loss\"])\n",
    "    current_lr = float(tf.keras.backend.get_value(model.optimizer.learning_rate))\n",
    "    tf.keras.backend.set_value(model.optimizer.learning_rate, current_lr * 0.5)\n",
    "\n",
    "    print(f\"Extension adaptative de {model_name}: +{extra_epochs} epochs (LR réduit à {current_lr * 0.5:.2e})\")\n",
    "    history_extra = model.fit(\n",
    "        train_ds,\n",
    "        validation_data=val_ds,\n",
    "        initial_epoch=current_epochs,\n",
    "        epochs=current_epochs + extra_epochs,\n",
    "        steps_per_epoch=STEPS_PER_EPOCH,\n",
    "        validation_steps=VALIDATION_STEPS,\n",
    "        callbacks=make_callbacks(model_name, stage=\"extended\", patience=5),\n",
    "        verbose=1,\n",
    "    )\n",
    "    return merge_histories(history_dict, history_extra.history)\n",
    "\n",
    "def set_trainable_layers(base_model, unfreeze_last):\n",
    "    base_model.trainable = True\n",
    "    for layer in base_model.layers[:-unfreeze_last]:\n",
    "        layer.trainable = False\n",
    "    for layer in base_model.layers[-unfreeze_last:]:\n",
    "        if isinstance(layer, layers.BatchNormalization):\n",
    "            layer.trainable = False\n",
    "\n",
    "def train_standard_model(model_name, model, cfg):\n",
    "    ensure_output_dirs()\n",
    "    train_ds = get_train_dataset(cfg.augmentation)\n",
    "    model.compile(\n",
    "        optimizer=keras.optimizers.Adam(cfg.learning_rate),\n",
    "        loss=\"sparse_categorical_crossentropy\",\n",
    "        metrics=classification_metrics(),\n",
    "    )\n",
    "    history = model.fit(\n",
    "        train_ds,\n",
    "        validation_data=val_ds,\n",
    "        epochs=cfg.epochs,\n",
    "        steps_per_epoch=STEPS_PER_EPOCH,\n",
    "        validation_steps=VALIDATION_STEPS,\n",
    "        callbacks=make_callbacks(model_name, stage=\"main\", patience=3),\n",
    "        verbose=1,\n",
    "    )\n",
    "\n",
    "    merged_history = maybe_extend_training(model, model_name, train_ds, history.history)\n",
    "    model.save(f\"models/phase4_models/{model_name}.keras\")\n",
    "    save_history(model_name, merged_history)\n",
    "    return {\"model\": model, \"history\": merged_history, \"config\": cfg}\n",
    "\n",
    "def train_transfer_model(model_name, model, base_model, cfg):\n",
    "    ensure_output_dirs()\n",
    "    train_ds = get_train_dataset(cfg.augmentation)\n",
    "\n",
    "    model.compile(\n",
    "        optimizer=keras.optimizers.Adam(cfg.learning_rate),\n",
    "        loss=\"sparse_categorical_crossentropy\",\n",
    "        metrics=classification_metrics(),\n",
    "    )\n",
    "\n",
    "    history_head = model.fit(\n",
    "        train_ds,\n",
    "        validation_data=val_ds,\n",
    "        epochs=cfg.head_epochs,\n",
    "        steps_per_epoch=STEPS_PER_EPOCH,\n",
    "        validation_steps=VALIDATION_STEPS,\n",
    "        callbacks=make_callbacks(model_name, stage=\"head\", patience=2),\n",
    "        verbose=1,\n",
    "    )\n",
    "\n",
    "    set_trainable_layers(base_model, cfg.unfreeze_layers)\n",
    "    model.compile(\n",
    "        optimizer=keras.optimizers.Adam(cfg.fine_tune_lr),\n",
    "        loss=\"sparse_categorical_crossentropy\",\n",
    "        metrics=classification_metrics(),\n",
    "    )\n",
    "\n",
    "    history_finetune = model.fit(\n",
    "        train_ds,\n",
    "        validation_data=val_ds,\n",
    "        initial_epoch=cfg.head_epochs,\n",
    "        epochs=cfg.epochs,\n",
    "        steps_per_epoch=STEPS_PER_EPOCH,\n",
    "        validation_steps=VALIDATION_STEPS,\n",
    "        callbacks=make_callbacks(model_name, stage=\"finetune\", patience=3),\n",
    "        verbose=1,\n",
    "    )\n",
    "\n",
    "    merged_history = merge_histories(history_head.history, history_finetune.history)\n",
    "    merged_history = maybe_extend_training(model, model_name, train_ds, merged_history)\n",
    "\n",
    "    model.save(f\"models/phase4_models/{model_name}.keras\")\n",
    "    save_history(model_name, merged_history)\n",
    "    return {\"model\": model, \"history\": merged_history, \"config\": cfg}"
   ]
