   "source": [
    "# Comparison mid-training – réponses alignées avec l'énoncé du TP\n",
    "\n",
    "def first_epoch_above(hist, key, threshold):\n",
    "    for i, value in enumerate(hist.get(key, []), start=1):\n",
    "        if value >= threshold:\n",
    "            return i\n",
    "    return None\n",
    "\n",
    "def convergence_label(epoch_40):\n",
    "    if epoch_40 is None:\n",
    "        return \"lentement (< 40% non atteint)\"\n",
    "    if epoch_40 <= 10:\n",
    "        return \"vite\"\n",
    "    if epoch_40 <= 20:\n",
    "        return \"moyen\"\n",
    "    return \"lentement\"\n",
    "\n",
    "comparison_rows = []\n",
    "for name, hist in all_histories.items():\n",
    "    acc30 = metric_at(hist, \"val_accuracy\", MID_TRAIN_EPOCH)\n",
    "    top5_30 = metric_at(hist, \"val_top5_acc\", MID_TRAIN_EPOCH)\n",
    "    train30 = metric_at(hist, \"accuracy\", MID_TRAIN_EPOCH)\n",
    "    gap30 = train30 - acc30\n",
    "    ep40 = first_epoch_above(hist, \"val_accuracy\", 0.40)\n",
    "\n",
    "    comparison_rows.append({\n",
    "        \"model\": name,\n",
    "        \"epochs_completed\": len(hist.get(\"loss\", [])),\n",
    "        \"train_acc@30\": train30,\n",
    "        \"val_acc@30\": acc30,\n",
    "        \"val_top5@30\": top5_30,\n",
    "        \"gap_train_val@30\": gap30,\n",
    "        \"overfitting\": \"oui\" if gap30 > 0.10 else \"non\",\n",
    "        \"convergence\": convergence_label(ep40),\n",
    "        \"epoch_40%_atteint\": ep40,\n",
    "        \"top1_cible(40-60%)\": \"OK\" if 0.40 <= acc30 <= 0.60 else \"HORS CIBLE\",\n",
    "        \"top5_cible(>80%)\": \"OK\" if top5_30 > 0.80 else \"HORS CIBLE\",\n",
    "    })\n",
    "\n",
    "comparison_rows.sort(key=lambda row: row[\"val_acc@30\"], reverse=True)\n",
    "\n",
    "print(f\"{'=' * 72}\")\n",
    "print(f\"  Modèle en tête à {MID_TRAIN_EPOCH} epochs : {comparison_rows[0]['model']}\")\n",
    "print(f\"{'=' * 72}\\n\")\n",
    "\n",
    "for row in comparison_rows:\n",
    "    print(f\"  {row['model']}\")\n",
    "    print(f\"    train_acc@30  : {row['train_acc@30']:.4f}\")\n",
    "    print(f\"    val_acc@30    : {row['val_acc@30']:.4f}  → {row['top1_cible(40-60%)']}\")\n",
    "    print(f\"    val_top5@30   : {row['val_top5@30']:.4f}  → {row['top5_cible(>80%)']}\")\n",
    "    print(f\"    convergence   : {row['convergence']}  (40% atteint epoch {row['epoch_40%_atteint']})\")\n",
    "    print(f\"    overfitting   : {row['overfitting']}  (gap={row['gap_train_val@30']:.4f})\")\n",
    "    print(f\"    epochs total  : {row['epochs_completed']}\")\n",
    "    print()\n",
    "\n",
    "csv_path = \"models/phase4_history/phase4_comparison_30epochs.csv\"\n",
    "with open(csv_path, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n",
    "    writer = csv.DictWriter(f, fieldnames=list(comparison_rows[0].keys()))\n",
    "    writer.writeheader()\n",
    "    writer.writerows(comparison_rows)\n",
    "\n",
    "print(f\"Tableau comparatif exporté → {csv_path}\")"
   ]
